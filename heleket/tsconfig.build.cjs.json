{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist-cjs",
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["dist", "dist-cjs", "node_modules", "test", "examples"]
}
